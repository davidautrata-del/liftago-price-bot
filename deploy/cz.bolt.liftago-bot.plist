<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>cz.bolt.liftago-bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>__BOT_DIR__/.venv/bin/python</string>
    <string>__BOT_DIR__/scheduler.py</string>
  </array>
  <key>WorkingDirectory</key><string>__BOT_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>BACKGROUND</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__BOT_DIR__/state/bot.log</string>
  <key>StandardErrorPath</key><string>__BOT_DIR__/state/bot.log</string>
</dict>
</plist>
